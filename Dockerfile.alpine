# Multi-stage Dockerfile for libpff-python on Alpine Linux
# Alpine uses musl libc instead of glibc - uses memmove for compatibility
# Stage 1: Builder
FROM alpine:3.19 AS builder

# Install build dependencies
RUN apk add --no-cache \
    autoconf \
    automake \
    build-base \
    ca-certificates \
    git \
    gettext-dev \
    libtool \
    pkgconfig \
    python3-dev \
    py3-pip \
    py3-wheel

WORKDIR /build

# Copy source
COPY . .

# Build wheel
# Note: Alpine enforces PEP 668, so we use --break-system-packages in container
RUN python3 -m pip install --break-system-packages --upgrade pip setuptools wheel build && \
    python3 -m build --wheel

# Stage 2: Runtime
FROM alpine:3.19

# Install runtime dependencies (minimal)
RUN apk add --no-cache \
    ca-certificates \
    libssl3 \
    python3 \
    py3-pip

WORKDIR /app

# Copy wheel from builder
COPY --from=builder /build/dist/*.whl .

# Install the package
# Alpine enforces PEP 668, use --break-system-packages in container
RUN pip install --break-system-packages --upgrade pip && \
    pip install --break-system-packages *.whl

# Verify installation
RUN python3 -c "import pypff; print(f'pypff installed on Alpine: {pypff.__file__}')"

CMD ["python3"]
