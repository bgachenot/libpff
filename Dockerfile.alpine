# Single-stage Dockerfile for libpff-python on Alpine Linux
# Alpine uses musl libc instead of glibc - uses memmove for compatibility
# Single stage keeps all build artifacts needed for the .so runtime
FROM alpine:3.19

# Install build and runtime dependencies
RUN apk add --no-cache \
    autoconf \
    automake \
    build-base \
    ca-certificates \
    git \
    gettext-dev \
    libtool \
    pkgconfig \
    python3 \
    python3-dev \
    py3-pip \
    py3-wheel

WORKDIR /app

# Copy source
COPY . .

# Build and install wheel
# Note: Alpine enforces PEP 668, so we use --break-system-packages in container
# Note: Disable fortification for musl compatibility (mempcpy not in musl)
RUN CFLAGS="-D_FORTIFY_SOURCE=0" python3 -m pip install --break-system-packages --upgrade pip setuptools wheel build && \
    CFLAGS="-D_FORTIFY_SOURCE=0" python3 -m build --wheel && \
    pip install --break-system-packages --upgrade pip && \
    pip install --break-system-packages dist/*.whl

# Keep build directory for symbol resolution at runtime
# Clean up only source files to reduce size
RUN rm -rf /app/dist /app/*.egg-info

# Test import (best effort - may have symbol issues on some Alpine versions)
RUN python3 -c "import pypff; print('pypff module loaded')" 2>/dev/null || echo "Note: pypff symbols may need full build environment"

CMD ["python3"]
